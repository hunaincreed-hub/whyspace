# Local Ollama is the default AI provider. It needs no cloud API key.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional local-resource bounds; Ollama generations are non-streaming.
OLLAMA_TIMEOUT_MS=120000
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
PORT=3000

# Optional cloud providers. Only used when explicitly selected.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-20b
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
